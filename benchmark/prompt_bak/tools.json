    "type": "function",
    "function": {
      "name": "workflow_plan",
      "description": "Create a Plan of ordered immutable sub-goals for the [CURRENT TASK]. Considering [FAIL PLANS] in the [CURRENT TASK] if present, do not propose the same or a similar Plan as any failed Plan.",
      "parameters": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "description": "Ordered immutable subtask goals.",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A simple immutable subtask goal that does not request tool use."
            },
            "minItems": 2
          }
        },
        "required": [
          "goals"
        ],
        "additionalProperties": false
      }
    }
  },
