{
  "schemaVersion": 1,
  "module": {
    "path": "src/server",
    "name": "server",
    "purpose": "Runs actor-based orchestration through intent stages, native tool invocations, invocation-summary continuation, streaming model relays, ordered execution, and task guardrails.",
    "changeStatus": "unchanged"
  },
  "childModules": [
    {
      "path": "src/server/intent",
      "name": "intent",
      "purpose": "Runs intent actors through planning, tool-calling, replanning, infeasible, subintent-complete, and completion stages; executes ordered subintent plans, records plan failures, and transitions rejected stage decisions."
    },
    {
      "path": "src/server/invocation",
      "name": "invocation",
      "purpose": "Runs invocation actors, validates and executes native tools, asks an invocation-summary stage to complete or continue chunked output, validates returned cursors, accumulates summaries, and publishes typed completion or failure results."
    },
    {
      "path": "src/server/model",
      "name": "model",
      "purpose": "Defines the streaming-only model backend contract, provides the shared OpenAiCore implementation (payload building, tool building, HTTP request/response streaming, SSE parsing and tool-call normalization, and Debug formatting) for OpenAI-compatible chat-completions backends, and exposes Deepseek and Glm as direct child implementations that each wrap OpenAiCore with their own provider name, endpoint, model, and api_key."
    },
    {
      "path": "src/server/plan",
      "name": "plan",
      "purpose": "Stores the ordered subintent signatures owned by an intent."
    },
    {
      "path": "src/server/prompt",
      "name": "prompt",
      "purpose": "Loads typed prompt templates and reusable modules, parses scalar and repeatable parameter or module markers, validates parameter ownership, and renders tagged package injections for stage requests."
    },
    {
      "path": "src/server/relay",
      "name": "relay",
      "purpose": "Runs streaming model-backed Relay actors for intent stages and invocation summaries, routes completion to the owning actor, enforces relay gates, and converts backend construction panics into errors."
    },
    {
      "path": "src/server/session",
      "name": "session",
      "purpose": "Owns session context, state, and runtime; accepts TaskRequest events, rejects task creation until a host and executor tools are available, logs registered tool counts and names at Info level, and delegates request normalization."
    },
    {
      "path": "src/server/stage",
      "name": "stage",
      "purpose": "Assembles stage-specific model requests, injects tagged task context and execution environment data, validates prompt packages, and parses typed intent-stage results."
    },
    {
      "path": "src/server/step",
      "name": "step",
      "purpose": "Runs step actors, checks the task completion deadline before creating each Step, and aggregates ordered structured invocation results into StepResult."
    },
    {
      "path": "src/server/task",
      "name": "task",
      "purpose": "Owns task actors and registries, normalizes completion-time and relay-count limits, gates new Steps and Relays, runs the task deadline watchdog, cancels all task-owned Relay, Invocation, Step, and Intent actors, and translates root results into external task status."
    }
  ],
