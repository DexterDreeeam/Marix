{
  "schemaVersion": 1,
  "module": {
    "path": "src/host",
    "name": "host",
    "purpose": "Owns Host connectivity, per-execution actor runtimes, executor workers, native tool routing, and direct cursor continuation through the bounded overlapping ExecutorCache.",
    "changeStatus": "unchanged"
  },
  "childModules": [
    {
      "path": "src/host/execution",
      "name": "execution",
      "purpose": "Runs each tool execution on its own OS thread with a current-thread Tokio runtime, applies ExecutorCache::try_cache so outputs at or below 24 KiB return whole while larger outputs return a first UTF-8-safe 16 KiB chunk with a continuation cursor, publishes typed ExecutionResult statuses, and defers cancellation until a blocking tool call returns."
    },
    {
      "path": "src/host/executor",
      "name": "executor",
      "purpose": "Owns host executor workers, tool execution routing, direct continuation requests backed by the bounded overlapping ExecutorCache, and typed invocation failure or continuation delivery."
    }
  ],
